<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.jaspersoft.jrsctl</groupId>
    <artifactId>jrsctl-parent</artifactId>
    <version>2.3.0-SNAPSHOT</version>
  </parent>

  <artifactId>jrsctl-acceptance</artifactId>
  <name>jrsctl :: acceptance</name>
  <description>Phase acceptance suites. Run one phase with: mvn -pl acceptance verify -Dphase=N (tests tagged phaseN)</description>

  <properties>
    <!-- The dependency audit (CI job and `-Pdependency-check`) judges what ships. This module ships
         nothing: its dependencies are test tooling (WireMock on Jetty 11, Testcontainers, commons-io)
         that never reaches the jar, the image or the SBOM, so it is excluded from the aggregate
         report. Its known findings are listed in docs/BUILD_STATUS.md. -->
    <dependency-check.skip>true</dependency-check.skip>
    <maven.deploy.skip>true</maven.deploy.skip>
    <!-- When -Dphase=N is given, only tests tagged "phaseN" run; otherwise every phase runs. -->
    <acceptance.groups/>
    <!-- The phase classes are independent: each works in its own @TempDir, WireMock takes a dynamic
         port, and the stand-in Tomcat processes are found by their own catalina.base path. They
         run in this many forks at once (one class at a time per fork). A class that is measured
         longest, Phase8CrashRecoveryTest, sets the floor of the module's wall clock, so more
         forks than about 3 add nothing on a 4 vCPU runner. -Dacceptance.forkCount=1 restores the
         old sequential run (use it to tell a real failure from a contention one). -->
    <acceptance.forkCount>4</acceptance.forkCount>
  </properties>

  <dependencies>
    <dependency><groupId>com.jaspersoft.jrsctl</groupId><artifactId>jrsctl-app</artifactId></dependency>
    <dependency><groupId>com.fasterxml.jackson.dataformat</groupId><artifactId>jackson-dataformat-yaml</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.wiremock</groupId><artifactId>wiremock</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.testcontainers</groupId><artifactId>testcontainers</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.testcontainers</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <forkCount>${acceptance.forkCount}</forkCount>
          <reuseForks>true</reuseForks>
          <!-- the classes that take longest (Phase8*, Phase5) start first, so the last fork is not
               left running one long class after the others finished -->
          <runOrder>reversealphabetical</runOrder>
          <groups>${acceptance.groups}</groups>
          <excludedGroups>${excluded.groups}</excludedGroups>
          <systemPropertyVariables>
            <jrsctl.jar>${project.basedir}/../app/target/jrsctl.jar</jrsctl.jar>
            <jrsctl.java>${java.home}/bin/java</jrsctl.java>
            <jrsctl.version>${project.version}</jrsctl.version>
            <jrsctl.acceptanceDir>${project.basedir}</jrsctl.acceptanceDir>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>single-phase</id>
      <activation><property><name>phase</name></property></activation>
      <properties>
        <acceptance.groups>phase${phase}</acceptance.groups>
      </properties>
    </profile>
  </profiles>
</project>
