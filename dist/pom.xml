<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.jaspersoft.jrsctl</groupId>
    <artifactId>jrsctl-parent</artifactId>
    <version>2.3.0-SNAPSHOT</version>
  </parent>

  <artifactId>jrsctl-dist</artifactId>
  <packaging>pom</packaging>
  <name>jrsctl :: dist</name>
  <description>jlink runtime image, portable ZIP/tar.gz, SBOM, checksums (Phase 7; activated with -Pdist, see ADR-0008)</description>

  <!--
    Without -Pdist this module does nothing, so the default build stays fast.
    With -Pdist (after the reactor built app/target/jrsctl.jar):
      compile          the three build helpers in src/main/java (Error Prone, -Werror like every module)
      prepare-package  copy lib/, bin/, README.txt, LICENSE-THIRD-PARTY.txt into target/image/<platform>/
                       RuntimeModules: jdeps + fixed union -> target/jlink-modules.txt, removes a stale runtime/
                       jlink           -> target/image/<platform>/runtime/
                       ImageLayout:    exec bits, LF endings, required files present
                       ImageManifest:  MANIFEST.sha256 over every file of the image
      package          maven-assembly-plugin: jrsctl-<version>-<platform>.zip | .tar.gz
                       ImageManifest checksum: <archive>.sha256
                       cyclonedx: jrsctl-<version>-sbom.json
    -Pdist,sign additionally runs scripts/sign-artifacts.* (signs only when JRSCTL_SIGNING_KEY is set; CI only).
  -->

  <properties>
    <dist.image.dir>${project.build.directory}/image/${dist.platform}</dist.image.dir>
    <dist.archive>${project.build.directory}/jrsctl-${project.version}-${dist.platform}.${dist.archive.ext}</dist.archive>
    <dist.app.jar>${project.basedir}/../app/target/jrsctl.jar</dist.app.jar>
    <dist.helper.cp>${project.build.outputDirectory}</dist.helper.cp>
    <!-- Modules always included on top of what jdeps reports for the shaded jar, and the ones dropped
         on purpose even though jdeps lists them (ADR-0008 records the smoke run that proves it safe). -->
    <dist.modules.fixed>java.base,java.sql,java.net.http,java.naming,java.logging,java.xml,java.management,java.security.sasl,java.security.jgss,java.instrument,jdk.crypto.ec,jdk.unsupported,jdk.zipfs,jdk.charsets</dist.modules.fixed>
    <dist.modules.excluded>java.desktop</dist.modules.excluded>
    <cyclonedx.version>2.9.3</cyclonedx.version>
    <maven-assembly.version>3.7.1</maven-assembly.version>
  </properties>

  <dependencies>
    <dependency><groupId>com.jaspersoft.jrsctl</groupId><artifactId>jrsctl-app</artifactId></dependency>
  </dependencies>

  <profiles>
    <!-- Platform facts; the same pom builds windows-x64 on Windows x86-64 and linux-x64 on Linux
         x86-64 (ADR-0002). Neither profile activates on any other host (macOS, ARM64), so the
         archive can never carry a foreign runtime under a supported label (review 3.6); the
         enforcer rule in the dist profile and RuntimeModules then stop the build with the reason. -->
    <profile>
      <id>dist-windows</id>
      <activation><os><family>windows</family><arch>amd64</arch></os></activation>
      <properties>
        <dist.platform>windows-x64</dist.platform>
        <dist.archive.ext>zip</dist.archive.ext>
        <dist.sign.executable>cmd</dist.sign.executable>
        <dist.sign.script>${project.basedir}/../scripts/sign-artifacts.cmd</dist.sign.script>
        <dist.sign.flag>/c</dist.sign.flag>
      </properties>
    </profile>
    <profile>
      <id>dist-linux</id>
      <activation><os><name>Linux</name><arch>amd64</arch></os></activation>
      <properties>
        <dist.platform>linux-x64</dist.platform>
        <dist.archive.ext>tar.gz</dist.archive.ext>
        <dist.sign.executable>sh</dist.sign.executable>
        <dist.sign.script>${project.basedir}/../scripts/sign-artifacts.sh</dist.sign.script>
        <dist.sign.flag>-e</dist.sign.flag>
      </properties>
    </profile>

    <profile>
      <id>dist</id>
      <build>
        <plugins>
          <!-- 0. refuse to package on a host outside ADR-0002 (review 3.6) -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-enforcer-plugin</artifactId>
            <executions>
              <execution>
                <id>enforce-dist-host</id>
                <goals><goal>enforce</goal></goals>
                <configuration>
                  <rules>
                    <requireProperty>
                      <property>dist.platform</property>
                      <regex>(windows|linux)-x64</regex>
                      <regexMessage>the portable archive is built on Windows or Linux x86-64 only (ADR-0002); this host is ${os.name} ${os.arch}</regexMessage>
                      <message>the portable archive is built on Windows or Linux x86-64 only (ADR-0002); this host is ${os.name} ${os.arch}</message>
                    </requireProperty>
                  </rules>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <!-- 1. compile the build helpers (packaging pom has no compile binding by default) -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-compiler-plugin</artifactId>
            <executions>
              <execution>
                <id>compile-dist-helpers</id>
                <phase>compile</phase>
                <goals><goal>compile</goal></goals>
              </execution>
            </executions>
          </plugin>

          <!-- 2. static image content: lib/jrsctl.jar, bin/, README.txt, LICENSE (the root file,
               byte for byte: ADR-0010), LICENSE-THIRD-PARTY.txt -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-resources-plugin</artifactId>
            <executions>
              <execution>
                <id>copy-image-files</id>
                <phase>prepare-package</phase>
                <goals><goal>copy-resources</goal></goals>
                <configuration>
                  <outputDirectory>${dist.image.dir}</outputDirectory>
                  <propertiesEncoding>UTF-8</propertiesEncoding>
                  <resources>
                    <resource>
                      <directory>${project.basedir}/src/image</directory>
                      <filtering>true</filtering>
                    </resource>
                    <resource>
                      <directory>${project.basedir}/..</directory>
                      <includes><include>LICENSE</include></includes>
                      <filtering>false</filtering>
                    </resource>
                  </resources>
                </configuration>
              </execution>
              <execution>
                <id>copy-app-jar</id>
                <phase>prepare-package</phase>
                <goals><goal>copy-resources</goal></goals>
                <configuration>
                  <outputDirectory>${dist.image.dir}/lib</outputDirectory>
                  <resources>
                    <resource>
                      <directory>${project.basedir}/../app/target</directory>
                      <includes><include>jrsctl.jar</include></includes>
                      <filtering>false</filtering>
                    </resource>
                  </resources>
                </configuration>
              </execution>
            </executions>
          </plugin>

          <!-- 3. archive (declared before exec so that the checksum execution in `package` runs after it) -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-assembly-plugin</artifactId>
            <version>${maven-assembly.version}</version>
            <executions>
              <execution>
                <id>portable-archive</id>
                <phase>package</phase>
                <goals><goal>single</goal></goals>
                <configuration>
                  <finalName>jrsctl-${project.version}</finalName>
                  <appendAssemblyId>true</appendAssemblyId>
                  <attach>false</attach>
                  <tarLongFileMode>posix</tarLongFileMode>
                  <descriptors>
                    <descriptor>${project.basedir}/src/assembly/portable.xml</descriptor>
                  </descriptors>
                </configuration>
              </execution>
            </executions>
          </plugin>

          <!-- 4. SBOM of the runtime dependency tree reachable from jrsctl-app (before exec so that signing sees it) -->
          <plugin>
            <groupId>org.cyclonedx</groupId>
            <artifactId>cyclonedx-maven-plugin</artifactId>
            <version>${cyclonedx.version}</version>
            <executions>
              <execution>
                <id>sbom</id>
                <phase>package</phase>
                <goals><goal>makeBom</goal></goals>
                <configuration>
                  <projectType>application</projectType>
                  <outputFormat>json</outputFormat>
                  <outputName>jrsctl-${project.version}-sbom</outputName>
                  <outputDirectory>${project.build.directory}</outputDirectory>
                  <includeTestScope>false</includeTestScope>
                  <includeProvidedScope>false</includeProvidedScope>
                  <includeSystemScope>false</includeSystemScope>
                  <skipNotDeployed>false</skipNotDeployed>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <!-- 5. jdeps, jlink, layout, manifest, checksum -->
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>runtime-modules</id>
                <phase>prepare-package</phase>
                <goals><goal>exec</goal></goals>
                <configuration>
                  <executable>${java.home}/bin/java</executable>
                  <arguments>
                    <argument>-cp</argument>
                    <argument>${dist.helper.cp}</argument>
                    <argument>com.jaspersoft.jrsctl.dist.RuntimeModules</argument>
                    <argument>${dist.app.jar}</argument>
                    <argument>${dist.modules.fixed}</argument>
                    <argument>${dist.modules.excluded}</argument>
                    <argument>${project.build.directory}/jlink-modules.txt</argument>
                    <argument>${dist.image.dir}/runtime</argument>
                  </arguments>
                </configuration>
              </execution>
              <execution>
                <id>jlink</id>
                <phase>prepare-package</phase>
                <goals><goal>exec</goal></goals>
                <configuration>
                  <executable>${java.home}/bin/jlink</executable>
                  <arguments>
                    <argument>@${project.build.directory}/jlink-modules.txt</argument>
                    <argument>--strip-debug</argument>
                    <argument>--no-header-files</argument>
                    <argument>--no-man-pages</argument>
                    <argument>--compress</argument>
                    <argument>zip-6</argument>
                    <argument>--dedup-legal-notices=error-if-not-same-content</argument>
                    <argument>--output</argument>
                    <argument>${dist.image.dir}/runtime</argument>
                  </arguments>
                </configuration>
              </execution>
              <execution>
                <id>image-layout</id>
                <phase>prepare-package</phase>
                <goals><goal>exec</goal></goals>
                <configuration>
                  <executable>${java.home}/bin/java</executable>
                  <arguments>
                    <argument>-cp</argument>
                    <argument>${dist.helper.cp}</argument>
                    <argument>com.jaspersoft.jrsctl.dist.ImageLayout</argument>
                    <argument>${dist.image.dir}</argument>
                  </arguments>
                </configuration>
              </execution>
              <execution>
                <id>image-manifest</id>
                <phase>prepare-package</phase>
                <goals><goal>exec</goal></goals>
                <configuration>
                  <executable>${java.home}/bin/java</executable>
                  <arguments>
                    <argument>-cp</argument>
                    <argument>${dist.helper.cp}</argument>
                    <argument>com.jaspersoft.jrsctl.dist.ImageManifest</argument>
                    <argument>manifest</argument>
                    <argument>${dist.image.dir}</argument>
                  </arguments>
                </configuration>
              </execution>
              <execution>
                <id>archive-checksum</id>
                <phase>package</phase>
                <goals><goal>exec</goal></goals>
                <configuration>
                  <executable>${java.home}/bin/java</executable>
                  <arguments>
                    <argument>-cp</argument>
                    <argument>${dist.helper.cp}</argument>
                    <argument>com.jaspersoft.jrsctl.dist.ImageManifest</argument>
                    <argument>checksum</argument>
                    <argument>${dist.archive}</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>

        </plugins>
      </build>
    </profile>

    <!-- Signing (spec §0 rule 11): the script signs when JRSCTL_SIGNING_KEY is set, otherwise it says so and exits 0. -->
    <profile>
      <id>sign</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>package</phase>
                <goals><goal>exec</goal></goals>
                <configuration>
                  <executable>${dist.sign.executable}</executable>
                  <arguments>
                    <argument>${dist.sign.flag}</argument>
                    <argument>${dist.sign.script}</argument>
                    <argument>${project.build.directory}</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
