<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.jaspersoft.jrsctl</groupId>
    <artifactId>jrsctl-parent</artifactId>
    <version>2.3.0-SNAPSHOT</version>
  </parent>

  <artifactId>jrsctl-ops</artifactId>
  <name>jrsctl :: ops</name>
  <description>Operations producing Plans (hotfix, export, import, upgrade) or Reports (init, doctor, smoke)</description>

  <properties>
    <!-- The plans themselves. Two points below core: the suite measures 79.1 on Windows
         and 79.6 on Linux, so the floor is the honest number for both hosts rather than an
         artefact of one. Raising it to 0.80 means covering SmokeOperation,
         DefaultUpgradeOperations and RunVendorUpgrade. -->
    <jacoco.line.minimum>0.80</jacoco.line.minimum>
  </properties>

  <dependencies>
    <dependency><groupId>com.jaspersoft.jrsctl</groupId><artifactId>jrsctl-core</artifactId></dependency>
    <dependency><groupId>com.jaspersoft.jrsctl</groupId><artifactId>jrsctl-jrs</artifactId></dependency>
    <dependency><groupId>org.wiremock</groupId><artifactId>wiremock</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.mockito</groupId><artifactId>mockito-core</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.testcontainers</groupId><artifactId>postgresql</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.testcontainers</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
  </dependencies>
</project>
