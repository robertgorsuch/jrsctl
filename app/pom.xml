<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.jaspersoft.jrsctl</groupId>
    <artifactId>jrsctl-parent</artifactId>
    <version>2.3.0-SNAPSHOT</version>
  </parent>

  <artifactId>jrsctl-app</artifactId>
  <name>jrsctl :: app</name>
  <description>Picocli CLI, main entry, shaded JAR</description>

  <dependencies>
    <dependency><groupId>com.jaspersoft.jrsctl</groupId><artifactId>jrsctl-ops</artifactId></dependency>
    <dependency><groupId>info.picocli</groupId><artifactId>picocli</artifactId></dependency>
    <!-- ADR-0037: Prompter.path line editing and filesystem completion, issue #102 -->
    <dependency><groupId>org.jline</groupId><artifactId>jline-terminal</artifactId></dependency>
    <dependency><groupId>org.jline</groupId><artifactId>jline-terminal-jni</artifactId></dependency>
    <dependency><groupId>org.jline</groupId><artifactId>jline-reader</artifactId></dependency>
    <dependency><groupId>org.mockito</groupId><artifactId>mockito-core</artifactId><scope>test</scope></dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <!-- One test JVM for this module (assessment item B2): the root pom forks one JVM per core,
             which was switched on without a timing record while BUILD_STATUS already noted
             Windows file-system flakiness under concurrency. The app tests start real listeners,
             spawn the shaded jar and swap System.in/err, so they run in one fork until the
             measurement recorded in docs/BUILD_STATUS.md says parallel forks are worth their
             risk here. -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <forkCount>1</forkCount>
          <reuseForks>true</reuseForks>
        </configuration>
      </plugin>
      <plugin>
        <!-- Offline documentation (spec §14 Phase 8, §17): the repository's Markdown deliverables are
             copied into the jar under docs/ at build time and served by `jrsctl docs` and the explain
             option. The copy lives under target/ only; nothing is committed twice. -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>embed-docs</id>
            <phase>generate-resources</phase>
            <goals><goal>copy-resources</goal></goals>
            <configuration>
              <outputDirectory>${project.build.outputDirectory}/docs</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.basedir}/..</directory>
                  <includes><include>README.md</include></includes>
                </resource>
                <resource>
                  <directory>${project.basedir}/../docs</directory>
                  <includes>
                    <include>operator-guide.md</include>
                    <include>recovery-runbook.md</include>
                    <include>security.md</include>
                    <include>hotfix-authoring.md</include>
                  </includes>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifest>
              <mainClass>com.jaspersoft.jrsctl.app.Main</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <finalName>jrsctl</finalName>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>com.jaspersoft.jrsctl.app.Main</mainClass>
                  <manifestEntries>
                    <Multi-Release>true</Multi-Release>
                  </manifestEntries>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
